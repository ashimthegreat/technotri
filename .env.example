# Copy to .env (or set these in cPanel > Setup Node.js App > Environment variables)
NODE_ENV=production
SITE_URL=https://technotri.com.np

# MySQL database created in cPanel > MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_technotri
DB_USER=cpaneluser_technotri
DB_PASSWORD=change-me

# Long random string (at least 32 characters). Changing it signs everyone out.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# First admin login, created automatically by `npm run seed` if it does not exist
ADMIN_EMAIL=info@technotri.com.np
ADMIN_NAME=Technotri Admin
ADMIN_PASSWORD=change-this-password

# Optional: email order confirmations through the cPanel mailbox
SMTP_HOST=mail.technotri.com.np
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@technotri.com.np
SMTP_PASSWORD=
MAIL_FROM=Technotri Store <info@technotri.com.np>
ORDER_NOTIFY_EMAIL=info@technotri.com.np

# Where product photos uploaded from the admin panel are stored (relative to the app folder)
UPLOAD_DIR=public/uploads

# Search & analytics (optional)
# Google Search Console > Settings > Ownership verification > HTML tag: paste only the content="…" value
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools HTML meta tag value
BING_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
GA4_ID=
